--==============================================================
-- ORIGINAL PART DATA
--==============================================================

local OriginalParts = {}

local ProcessedParts = {}

local function SaveOriginal(part)

	if not part:IsA("BasePart") then
		return
	end

	if OriginalParts[part] then
		return
	end

	OriginalParts[part] = {

		Material = part.Material,
		Reflectance = part.Reflectance,
		Transparency = part.Transparency

	}

end

--==============================================================
-- FLOOR DETECTION
--==============================================================

local function IsFloor(part)

	if not part:IsA("BasePart") then
		return false
	end

	local s =
		part.Size

	local horizontal =
		math.max(s.X,s.Z)

	local vertical =
		math.min(s.X,s.Z)

	if horizontal < Config.FloorMinSize then
		return false
	end

	if s.Y <= horizontal * 0.30 then
		return true
	end

	return false
end

--==============================================================
-- WALL DETECTION
--==============================================================

local function IsWall(part)

	if not part:IsA("BasePart") then
		return false
	end

	local s =
		part.Size

	local xWall =
		s.Y >= Config.WallMinSize
		and s.X >= Config.WallMinSize * 0.5
		and s.Y > s.Z * 1.4

	local zWall =
		s.Y >= Config.WallMinSize
		and s.Z >= Config.WallMinSize * 0.5
		and s.Y > s.X * 1.4

	return xWall or zWall
end

--==============================================================
-- APPLY REFLECTIVE MATERIAL
--==============================================================

local function ApplyReflectiveMaterial(
	part,
	strength,
	mode
)

	if not part:IsA("BasePart") then
		return
	end

	if part:IsDescendantOf(Effects) then
		return
	end

	SaveOriginal(part)

	--------------------------------------------------
	-- GLASS
	--------------------------------------------------

	if Config.GlassMode then

		pcall(function()

			part.Material =
				Enum.Material.Glass

			part.Reflectance =
				math.clamp(
					strength * 0.12,
					0,
					0.15
				)

		end)

		return
	end

	--------------------------------------------------
	-- METAL
	--------------------------------------------------

	if Config.MetalMode then

		pcall(function()

			part.Material =
				Enum.Material.Metal

			-- Reflectance оставляем небольшим:
			-- основной эффект идёт через
			-- EnvironmentSpecularScale.

			part.Reflectance =
				math.clamp(
					strength * 0.08,
					0,
					0.08
				)

		end)

		return
	end

	--------------------------------------------------
	-- SMOOTH
	--------------------------------------------------

	if Config.SmoothMode then

		pcall(function()

			part.Material =
				Enum.Material.SmoothPlastic

			part.Reflectance =
				math.clamp(
					strength * 0.15,
					0,
					0.15
				)

		end)

	end
end

--==============================================================
-- PROCESS WORLD
--==============================================================

local function ProcessWorld()

	if not Config.Enabled then
		return
	end

	local processed =
		0

	local floors =
		0

	local walls =
		0

	local objects =
		0

	for _,part in ipairs(
		workspace:GetDescendants()
	) do

		if processed >=
			Config.MaxProcessedParts then

			break
		end

		if part:IsA("BasePart") then

			if not part:IsDescendantOf(
				Player.Character or Instance.new("Folder")
			) then

				local ok =
					pcall(function()

						--------------------------------------------------
						-- FLOOR
						--------------------------------------------------

						if Config.ProcessFloor
							and IsFloor(part) then

							ApplyReflectiveMaterial(
								part,
								Config.FloorReflection,
								"Floor"
							)

							ProcessedParts[part] = true

							floors += 1
							processed += 1

						--------------------------------------------------
						-- WALL
						--------------------------------------------------

						elseif Config.ProcessWalls
							and IsWall(part) then

							ApplyReflectiveMaterial(
								part,
								Config.WallReflection,
								"Wall"
							)

							ProcessedParts[part] = true

							walls += 1
							processed += 1

						--------------------------------------------------
						-- OBJECTS
						--------------------------------------------------

						elseif Config.ProcessObjects
							and not part:IsA("Terrain") then

							ApplyReflectiveMaterial(
								part,
								Config.ObjectReflection,
								"Object"
							)

							ProcessedParts[part] = true

							objects += 1
							processed += 1

						end

					end)

				if not ok then
					-- intentionally ignored
				end

			end
		end
	end

	print(
		"[HYBRID RTX]",
		"Floor:",floors,
		"Walls:",walls,
		"Objects:",objects,
		"Total:",processed
	)

end

--==============================================================
-- LIGHTING
