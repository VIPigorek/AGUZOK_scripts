local function ApplyLighting()

	if not Config.Enabled then
		return
	end

	--------------------------------------------------
	-- FUTURE
	--------------------------------------------------

	pcall(function()

		Lighting.Technology =
			Enum.Technology.Future

	end)

	--------------------------------------------------
	-- ENVIRONMENT REFLECTION
	--------------------------------------------------

	pcall(function()

		if Config.ReflectionEnabled then

			Lighting.EnvironmentSpecularScale =
				math.clamp(
					Config.EnvironmentSpecular,
					0,
					1
				)

			Lighting.EnvironmentDiffuseScale =
				math.clamp(
					Config.EnvironmentDiffuse,
					0,
					1
				)

		else

			Lighting.EnvironmentSpecularScale =
				0

			Lighting.EnvironmentDiffuseScale =
				0

		end

	end)

	--------------------------------------------------
	-- SHADOWS
	--------------------------------------------------

	pcall(function()

		Lighting.GlobalShadows =
			Config.GlobalShadows

	end)

	--------------------------------------------------
	-- AMBIENT
	--------------------------------------------------

	pcall(function()

		if Config.ReflectionEnabled then

			Lighting.Ambient =
				Color3.fromRGB(
					12,
					12,
					15
				)

			Lighting.OutdoorAmbient =
				Color3.fromRGB(
					20,
					20,
					24
				)

		else

			Lighting.Ambient =
				Color3.fromRGB(
					45,
					42,
					45
				)

		end

	end)

	--------------------------------------------------
	-- EXPOSURE
	--------------------------------------------------

	pcall(function()

		Lighting.ExposureCompensation =
			Config.Exposure

	end)

end

