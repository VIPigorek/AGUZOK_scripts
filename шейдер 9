--==============================================================
-- TOGGLE
--==============================================================

local function Toggle(
	parent,
	text,
	y,
	getter,
	setter,
	callback
)

	local button =
		Instance.new("TextButton")

	button.Size =
		UDim2.new(1,0,0,40)

	button.Position =
		UDim2.new(0,0,0,y)

	button.BorderSizePixel =
		0

	button.TextSize =
		12

	button.Font =
		Enum.Font.GothamBold

	button.TextColor3 =
		Color3.new(1,1,1)

	button.Parent =
		parent

	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0,10)

	corner.Parent =
		button

	local function Refresh()

		if getter() then

			button.Text =
				"🟢 "..text.." : ON"

			button.BackgroundColor3 =
				Color3.fromRGB(
					60,30,78
				)

		else

			button.Text =
				"🔴 "..text.." : OFF"

			button.BackgroundColor3 =
				Color3.fromRGB(
					26,20,31
				)

		end

	end

	Refresh()

	button.MouseButton1Click:Connect(function()

		setter(
			not getter()
		)

		Refresh()

		if callback then
			callback()
		end

	end)

	return button
end

--==============================================================
-- NUMBER INPUT
--==============================================================

local function Input(
	parent,
	text,
	y,
	key,
	minValue,
	maxValue,
	callback
)

	local holder =
		Instance.new("Frame")

	holder.Size =
		UDim2.new(1,0,0,45)

	holder.Position =
		UDim2.new(0,0,0,y)

	holder.BackgroundColor3 =
		Color3.fromRGB(
			22,18,28
		)

	holder.BorderSizePixel =
		0

	holder.Parent =
		parent

	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0,10)

	corner.Parent =
		holder

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.new(0.62,0,1,0)

	label.Position =
		UDim2.new(0,10,0,0)

	label.BackgroundTransparency =
		1

	label.Text =
		text

	label.TextColor3 =
		Color3.fromRGB(
			225,225,230
		)

	label.TextSize =
		11

	label.Font =
		Enum.Font.GothamBold

	label.TextXAlignment =
		Enum.TextXAlignment.Left

	label.Parent =
		holder

	local box =
		Instance.new("TextBox")

	box.Size =
		UDim2.new(0.31,0,0,32)

	box.Position =
		UDim2.new(0.66,0,0.5,-16)

	box.BackgroundColor3 =
		Color3.fromRGB(
			8,7,11
		)

	box.Text =
		tostring(Config[key])

	box.TextColor3 =
		Color3.new(1,1,1)

	box.TextSize =
		11

	box.Font =
		Enum.Font.GothamBold

	box.ClearTextOnFocus =
		false

	box.BorderSizePixel =
		0

	box.Parent =
		holder

	local bc =
		Instance.new("UICorner")

	bc.CornerRadius =
		UDim.new(0,8)

	bc.Parent =
		box

	box.FocusLost:Connect(function()

		local value =
			tonumber(box.Text)

		if not value then

			box.Text =
				tostring(Config[key])

			return
		end

		value =
			math.clamp(
				value,
				minValue,
				maxValue
			)

		Config[key] =
			value

		box.Text =
			tostring(value)

		print(
			"[HYBRID RTX]",
			key,
			"=",
			value
		)

		if Config.Enabled then
			ApplyEffects()
		end

		if callback then
			callback()
		end

	end)

	return box
end

