--==============================================================
-- RESTORE
--==============================================================

local function RestoreParts()

	local restored =
		0

	for part,data in pairs(
		OriginalParts
	) do

		if part
			and part.Parent then

			pcall(function()

				part.Material =
					data.Material

				part.Reflectance =
					data.Reflectance

				part.Transparency =
					data.Transparency

				restored += 1

			end)

		end

	end

	print(
		"[HYBRID RTX] Restored:",
		restored
	)

end

