task.spawn(function()

	while Gui.Parent do

		if Config.Enabled then

			local interval =
				math.clamp(
					tonumber(
						Config.UpdateInterval
					) or 1,
					0.1,
					60
				)

			task.wait(interval)

			if Config.Enabled then

				pcall(function()
					ProcessWorld()
				end)

			end

		else

			task.wait(0.5)

		end

	end

end)

