--==================================================
-- ПОМОЩНИКИ ДЛЯ TOUCH/MOUSE
--==================================================

-- На телефоне события приходят как Enum.UserInputType.Touch,
-- а не MouseButton1 — поэтому везде проверяем оба варианта.

local function IsPressInput(Input)
	return Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch
end

local function IsMoveInput(Input)
	return Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch
end

--==================================================
-- ПОИСК ПОДВЕСКИ
--==================================================

local function getSprings()
	local Vehicles = workspace:WaitForChild("Vehicles")
	local Vehicle = Vehicles:WaitForChild(Player.Name)
	local Constraints = Vehicle:WaitForChild("Constraints")

	return {
		FrontLeft = Constraints:WaitForChild("FLSpring"),
		FrontRight = Constraints:WaitForChild("FRSpring"),
		RearLeft = Constraints:WaitForChild("RLSpring"),
		RearRight = Constraints:WaitForChild("RRSpring"),
	}
end

local Springs

local Success, Result = pcall(getSprings)

if Success then
	Springs = Result
else
	warn("Не удалось найти подвеску:", Result)
	return
end

