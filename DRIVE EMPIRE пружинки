-- ПОВТОРНЫЙ ПОИСК ПОДВЕСКИ
-- (на случай респавна машины / смены транспорта)
--==================================================

local function RefreshSprings()
	local RefreshSuccess, RefreshResult = pcall(getSprings)

	if RefreshSuccess then
		Springs = RefreshResult
		LoadValues()
	else
		warn("Не удалось обновить подвеску:", RefreshResult)
	end
end

