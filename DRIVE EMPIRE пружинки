-- ЗАГРУЗКА ТЕКУЩИХ ЗНАЧЕНИЙ
--==================================================

local function LoadValues()
	local SelectedSprings = GetSelectedSprings()

	if #SelectedSprings == 0 then
		return
	end

	local Spring = SelectedSprings[1]

	if not Spring then
		return
	end

	for Property, Slider in pairs(Sliders) do
		local Success, Value = pcall(function()
			return Spring[Property]
		end)

		if Success and typeof(Value) == "number" then
			Slider.SetValue(Value)
		end
	end
end

