local Sliders = {}

local function CreateSlider(Property, Order)
	local Data = RANGES[Property]

	local Container = Instance.new("Frame")
	Container.Name = Property
	Container.Size = UDim2.new(1, 0, 0, 40)
	Container.BackgroundTransparency = 1
	Container.LayoutOrder = Order
	Container.Parent = Content

	-- Название

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, 0, 0, 14)
	Label.Position = UDim2.fromOffset(0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = Property
	Label.TextColor3 = Color3.fromRGB(230, 230, 235)
	Label.TextSize = 11
	Label.Font = Enum.Font.GothamBold
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Container

	-- Строка: поле ввода + кнопка "Ввод"

	local Row = Instance.new("Frame")
	Row.Size = UDim2.new(1, 0, 0, 22)
	Row.Position = UDim2.fromOffset(0, 16)
	Row.BackgroundTransparency = 1
	Row.Parent = Container

	local Box = Instance.new("TextBox")
	Box.Size = UDim2.new(1, -48, 1, 0)
	Box.Position = UDim2.fromOffset(0, 0)
	Box.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	Box.Text = FormatNumber(Data.Min, Data.Decimals)
	Box.PlaceholderText = "0"
	Box.TextColor3 = Color3.fromRGB(255, 255, 255)
	Box.PlaceholderColor3 = Color3.fromRGB(140, 140, 148)
	Box.TextSize = 11
	Box.Font = Enum.Font.Gotham
	Box.ClearTextOnFocus = false
	Box.Parent = Row

	local BoxCorner = Instance.new("UICorner")
	BoxCorner.CornerRadius = UDim.new(0, 6)
	BoxCorner.Parent = Box

	local BoxPadding = Instance.new("UIPadding")
	BoxPadding.PaddingLeft = UDim.new(0, 8)
	BoxPadding.PaddingRight = UDim.new(0, 8)
	BoxPadding.Parent = Box

	local Apply = Instance.new("TextButton")
	Apply.Size = UDim2.new(0, 42, 1, 0)
	Apply.Position = UDim2.new(1, -42, 0, 0)
	Apply.BackgroundColor3 = Color3.fromRGB(65, 120, 220)
	Apply.Text = "ВВОД"
	Apply.TextColor3 = Color3.fromRGB(255, 255, 255)
	Apply.TextSize = 10
	Apply.Font = Enum.Font.GothamBold
	Apply.Parent = Row

	local ApplyCorner = Instance.new("UICorner")
	ApplyCorner.CornerRadius = UDim.new(0, 6)
	ApplyCorner.Parent = Apply

	local CurrentValue = Data.Min

	--==================================================
	-- ИЗМЕНЕНИЕ ЗНАЧЕНИЯ
	--==================================================

	local function SetValue(Value)
		Value = math.clamp(Value, Data.Min, Data.Max)

		if Data.Decimals == 0 then
			Value = math.floor(Value + 0.5)
		else
			local Multiplier = 10 ^ Data.Decimals
			Value = math.floor(Value * Multiplier + 0.5) / Multiplier
		end

		CurrentValue = Value
		Box.Text = FormatNumber(Value, Data.Decimals)

		-- Применяем значение ко всем выбранным колёсам

		for _, Spring in ipairs(GetSelectedSprings()) do
			if Spring and Spring:IsA("SpringConstraint") then
				pcall(function()
					Spring[Property] = Value
				end)
			end
		end
	end

	--==================================================
	-- ПРИМЕНЕНИЕ ВВЕДЁННОГО ЗНАЧЕНИЯ
	--==================================================

	local function ApplyFromBox()
		local Number = tonumber(Box.Text)

		if Number then
			SetValue(Number)
		else
			-- Некорректный ввод — возвращаем текущее значение

			Box.Text = FormatNumber(CurrentValue, Data.Decimals)
		end
	end

	Apply.MouseButton1Click:Connect(ApplyFromBox)

	Box.FocusLost:Connect(function(EnterPressed)
		if EnterPressed then
			ApplyFromBox()
		end
	end)

	Sliders[Property] = {
		SetValue = SetValue,
		GetValue = function()
			return CurrentValue
		end,
	}
end

