local function TeleportToPlayer(Player)

	if not Player
		or not LocalPlayer.Character
		or not Player.Character then
		return false
	end

	local MyRoot =
		LocalPlayer.Character:
		FindFirstChild("HumanoidRootPart")

	local TargetRoot =
		Player.Character:
		FindFirstChild("HumanoidRootPart")

	if not MyRoot
		or not TargetRoot then
		return false
	end

	MyRoot.CFrame =
		TargetRoot.CFrame *
		CFrame.new(0,0,4)

	return true

end

