local function RefreshMarketUI()

	table.sort(
		ActiveOffers,
		function(A,B)
			return GetPrice(A) <
				GetPrice(B)
		end
	)

	local MaxPrice =
		tonumber(
			MaxPriceInput.Text
		) or math.huge

	ClearCards()

	local Order = 0

	for _,Offer in ipairs(
		ActiveOffers
	) do

		if GetPrice(Offer)
			<= MaxPrice then

			Order += 1

			CreateCard(
				Offer,
				Order
			)

		end

	end

	UpdateCanvas()

end

--==============================================================
-- НОВОЕ ОБЪЯВЛЕНИЕ
--==============================================================

if OnOfferAdded then

	OnOfferAdded.OnClientEvent:Connect(
		function(
			SellerPlayer,
			OfferData
		)

			if not SellerPlayer
				or not OfferData
				or not OfferData.Item then
				return
			end

			if OfferData.Item.Type
				and OfferData.Item.Type ~= "Car" then
				return
			end

			for _,Existing in ipairs(
				ActiveOffers
			) do

				if Existing.Data
					and Existing.Data.OfferId
					==
					OfferData.OfferId then

					return
				end

			end

			table.insert(
				ActiveOffers,
				{
					SellerName =
						SellerPlayer.Name,

					Data =
						OfferData
				}
			)

			RefreshMarketUI()

		end
	)

end

